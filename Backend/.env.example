# Gemini API Key (Required for AI travel guide text generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Murf AI API Key (Required for voice audio generation)
MURF_API_KEY=your_murf_api_key_here

# Optional Flask Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

